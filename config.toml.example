# ash configuration example
# Copy to config.toml and fill in your values.
# The API key may alternatively be supplied via the ASH_API_KEY environment variable.

# Required
api_type      = "openai"          # openai | anthropic | gemini | ollama | groq | cohere | deepseek | xai
api_key       = "sk-..."          # your API key (or omit and set ASH_API_KEY/provider env var)
model_name    = "gpt-5.6"          # latest GPT-5 family; uses Responses API automatically

# Optional: override the default API endpoint (e.g. for proxies or local models)
# base_url = "https://my-proxy.example.com/v1"
# OpenAI mode override (optional): ASH_OPENAI_API_MODE=chat|responses
# Reasoning control for GPT-5 models (optional): ASH_REASONING_EFFORT=low|medium|high

# Commands that are allowed to run (empty = all commands allowed)
allow_list = ["ls", "cat", "git", "echo", "curl"]

# Commands that are always rejected (deny wins over allow if a command appears in both)
deny_list = ["rm", "sudo", "dd", "mkfs"]

# LLM request timeout in seconds (default: 60)
# request_timeout_secs = 60

# Tools to probe in PATH and include in LLM context (default: git, curl, docker, python3, node, cargo, make)
# tools_to_probe = ["git", "curl", "docker", "python3", "node", "cargo", "make"]

# Include OS, architecture, and current working directory in the LLM prompt context.
# Note: cwd may reveal internal path structure to the LLM API.
# collect_sys_info = true

# Include SHELL, TERM, and available tool list in the LLM prompt context.
# PATH is never forwarded regardless of this setting.
# collect_env_info = true
